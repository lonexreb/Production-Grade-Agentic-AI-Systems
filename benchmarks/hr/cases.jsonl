{"name": "direct-deposit-approved", "input": {"email": "I switched banks, please update my direct deposit", "decision": {"approved": true, "by": "mgr@corp.example"}}, "expect": {"paused": true, "response_contains": "completed", "payroll_rows": 1, "events": ["approval_requested", "approval_granted", "tool_call", "notification_sent"]}}
{"name": "direct-deposit-rejected", "input": {"email": "new bank account for my salary please", "decision": {"approved": false, "by": "mgr@corp.example", "note": "unverified"}}, "expect": {"paused": true, "response_contains": "declined", "payroll_rows": 0, "events": ["approval_requested", "approval_rejected", "notification_sent"]}}
{"name": "bank-keyword-detected", "input": {"email": "please move my pay to my new bank", "decision": {"approved": true, "by": "mgr@corp.example"}}, "expect": {"paused": true, "response_contains": "update_direct_deposit", "payroll_rows": 1}}
